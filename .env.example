PORT=4000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/distributed_scheduler
JWT_SECRET=super-secret-distributed-job-scheduler-jwt-key-2026
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=500
WORKER_HEARTBEAT_INTERVAL_MS=5000
REAPER_INTERVAL_MS=10000
SCHEDULER_POLL_INTERVAL_MS=1000

# Bonus features
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=60000
WORKER_SHARD_ID=0
# Optional: enables real Claude-generated DLQ failure summaries instead of the built-in heuristic fallback
ANTHROPIC_API_KEY=
