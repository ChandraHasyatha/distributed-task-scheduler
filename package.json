{
  "name": "distributed-job-scheduler",
  "version": "1.0.0",
  "description": "Production-grade Distributed Job Scheduler with Atomic Claiming and Web Dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:frontend": "cd src/frontend && npm run build",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/worker.ts",
    "dev:scheduler": "tsx watch src/scheduler/scheduler.ts",
    "dev:frontend": "cd src/frontend && npm run dev",
    "migrate": "tsx src/core/db/migrate.ts",
    "test": "vitest run",
    "test:concurrency": "vitest run tests/concurrency",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@fastify/websocket": "8.3.1",
    "bcrypt": "^5.1.1",
    "croner": "^8.1.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "pg": "^8.12.0",
    "pg-mem": "^2.8.1",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "uuid": "^10.0.0",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
